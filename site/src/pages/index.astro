---
import { Image } from 'astro:assets';
import BrandHead from '../components/BrandHead.astro';
import Metadata from '../components/Metadata.astro';
import logo from '../../../assets/kyoto-logo.png';
import goldenRetriever from '../assets/reviews/golden-retriever.png';
import corgi from '../assets/reviews/corgi.png';
import shiba from '../assets/reviews/shiba.png';
import tuxedoCat from '../assets/reviews/tuxedo-cat.png';
import tabby from '../assets/reviews/tabby.png';
import '../styles/home.css';
const description = 'The agent that focuses on what you build, not what it does. A coding agent for your terminal, with permissions, results, and proof.';
const title = 'Kyoto Agent · Focus on what you build';
const reviews = [
  { image: goldenRetriever, name: 'Sunny', breed: 'Golden retriever', quote: 'I bring the enthusiasm. Kyoto brings the plan. We both get very excited when the tests pass.' },
  { image: shiba, name: 'Suki', breed: 'Shiba', quote: 'Asks before touching my things. Shows me the result. Finally, someone with manners.' },
  { image: corgi, name: 'Mochi', breed: 'Corgi', quote: 'Short legs, long backlog. Having Kyoto beside me makes the next step feel a lot closer.' },
  { image: tabby, name: 'Tora', breed: 'Tabby', quote: 'I inspect every diff like a suspicious cardboard box. The proof is the part that wins me over.' },
  { image: tuxedoCat, name: 'Miso', breed: 'Tuxedo cat', quote: 'I like knowing what changed and why. Then I can get back to my real job: sitting on the keyboard.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Metadata title={title} description={description} />
    <BrandHead />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="/" aria-label="Kyoto Agent home">
        <Image src={logo} alt="Kyoto Agent" width={200} format="webp" loading="eager" />
      </a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Documentation</a>
        <a href="https://github.com/pmdroid/kyotoagent">GitHub <span aria-hidden="true">↗</span></a>
        <a class="nav-start" href="/docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">The agent that focuses on <em>what you build.</em></h1>
          <p class="slogan-end">Not what it does.</p>
          <p class="intro">Meet Kyoto. A coding companion that keeps your attention on the work. Your requests, your decisions, the result, and the proof.</p>
          <div class="actions">
            <a class="button" href="/docs/getting-started/">Build with Kyoto <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>
      <section class="workflow" id="how-it-works" aria-labelledby="workflow-title">
        <div class="wrap workflow-layout">
          <div class="workflow-copy">
            <h2 id="workflow-title">Less to watch.<br />More to make.</h2>
            <p>Kyoto works on the machine with your code. Follow along in your terminal, or connect from another device.</p>
            <p>When it needs a decision, it asks. When the work is done, you get the result and the checks behind it.</p>
            <a class="text-link" href="/docs/tools/">How permissions work <span aria-hidden="true">→</span></a>
          </div>
          <figure class="session-example">
            <div class="session-heading"><span>Kyoto Agent</span><span>Example session</span></div>
            <dl>
              <div><dt>You</dt><dd>Add a dark mode toggle to the settings page.</dd></div>
              <div><dt>Permission</dt><dd>Update the settings page and its styles?<span class="decision">Allowed for this session</span></dd></div>
              <div><dt>Result</dt><dd>Dark mode is ready. Your choice stays saved between visits.</dd></div>
              <div class="proof-row"><dt>Proof</dt><dd><span>2 files changed</span><span>Tests passed</span><span>Build passed</span></dd></div>
            </dl>
            <figcaption>An illustrative conversation. Requests, decisions, results, and proof.</figcaption>
          </figure>
        </div>
      </section>
      <section class="reviews wrap" id="reviews" aria-labelledby="reviews-title">
        <h2 id="reviews-title">Good company.<br />Strong opinions.</h2>
        <p class="reviews-intro">Fictional reviews from Kyoto's animal friends.</p>
        <div class="reviews-grid">
          {reviews.map((review) => (
            <figure class="mascot-review">
              <Image src={review.image} alt={`${review.breed} in a Kyoto hoodie`} widths={[144, 288]} sizes="(max-width: 760px) 88px, 144px" width={144} height={144} format="webp" loading="lazy" />
              <div>
                <blockquote><p>{review.quote}</p></blockquote>
                <figcaption><span class="review-name">{review.name}</span><span class="review-breed">{review.breed}</span></figcaption>
              </div>
            </figure>
          ))}
        </div>
      </section>
      <section class="start wrap" aria-labelledby="start-title">
        <div>
          <h2 id="start-title">Bring an idea.<br />Start a session.</h2>
          <p>Build Kyoto with Rust, connect your model, and open the project you want to work on.</p>
          <a class="text-link" href="/docs/getting-started/">Follow the quick start <span aria-hidden="true">→</span></a>
        </div>
        <ol class="steps">
          <li><div><h3>Install from source</h3><p>Clone the repo, then run this inside it.</p></div><pre><code>cargo install --path .</code></pre></li>
          <li><div><h3>Start the server</h3><p>Keep this running on the machine with your code.</p></div><pre><code>kyotoagent serve</code></pre></li>
          <li><div><h3>Open your project</h3><p>In a second terminal, run this in your project folder.</p></div><pre><code>kyotoagent</code></pre></li>
          <li><div><h3>Connect a model</h3><p>In the Kyoto terminal, press Ctrl-K and choose Providers to sign in or enter an API key. Press Ctrl-T to start a session.</p></div><pre><code>Ctrl-K → Providers</code></pre></li>
        </ol>
      </section>
      <section class="docs-banner wrap" aria-labelledby="docs-title">
        <h2 id="docs-title">Get to know Kyoto.</h2>
        <div class="doc-links">
          <a href="/docs/tui/">Terminal controls <span aria-hidden="true">↗</span></a>
          <a href="/docs/model/">Your model, your setup <span aria-hidden="true">↗</span></a>
          <a href="/docs/server/">Connect remotely <span aria-hidden="true">↗</span></a>
          <a href="/docs/development/">Build and contribute <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>
    <footer class="footer wrap">
      <p>Kyoto Agent. Good company for good work.</p>
      <div><a href="/docs/">Docs</a><a href="https://github.com/pmdroid/kyotoagent">Source on GitHub</a></div>
    </footer>
  </body>
</html>
